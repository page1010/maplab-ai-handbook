{
  "version": "0.2.0",
  "updated_at": "2026-05-21",
  "pipelines": [
    {
      "pipeline_id": "maplab_a6_quote",
      "name": "A6 urgent quote route",
      "steps": [
        {
          "id": "intake",
          "input_type": "TelegramOrLineMessage",
          "output_type": "CaseSummary"
        },
        {
          "id": "route_guard",
          "input_type": "CaseSummary",
          "output_type": "RouteDecision"
        },
        {
          "id": "a5_quote",
          "input_type": "QuoteRequest",
          "output_type": "QuoteDraft"
        },
        {
          "id": "a7_reply",
          "input_type": "QuoteFacts",
          "output_type": "CustomerReplyDraft"
        },
        {
          "id": "approval",
          "input_type": "CustomerReplyDraft",
          "output_type": "OwnerMinaApprovedAction"
        }
      ]
    },
    {
      "pipeline_id": "investment_os_research",
      "name": "Investment OS research route",
      "steps": [
        {
          "id": "theme_stage",
          "input_type": "WorldviewNewsOrScanSeed",
          "output_type": "ThemeThesis"
        },
        {
          "id": "fact_check",
          "input_type": "ThemeThesis",
          "output_type": "VerifiedFactsAndMissingData"
        },
        {
          "id": "risk_left_right",
          "input_type": "VerifiedFactsAndMissingData",
          "output_type": "RiskLeftRightReview"
        },
        {
          "id": "owner_brief",
          "input_type": "RiskLeftRightReview",
          "output_type": "OwnerResearchBrief"
        }
      ]
    },
    {
      "pipeline_id": "memory_feedback_loop",
      "name": "External memory feedback loop",
      "steps": [
        {
          "id": "session_end",
          "input_type": "WorkResult",
          "output_type": "CommitAndResumePrompt"
        },
        {
          "id": "pitfall_capture",
          "input_type": "RepeatedFailure",
          "output_type": "PitfallEntry"
        },
        {
          "id": "role_module_sync",
          "input_type": "RoleChange",
          "output_type": "ChromeExtensionModule"
        },
        {
          "id": "panel_refresh",
          "input_type": "NewSurface",
          "output_type": "VisibleEntrypoint"
        }
      ]
    }
  ],
  "types": {
    "CaseSummary": {
      "required": ["case_id", "source", "customer_need", "missing_fields", "evidence_links"]
    },
    "RouteDecision": {
      "required": ["mode", "primary_runtime", "fallback_runtime", "reason"]
    },
    "QuoteDraft": {
      "required": ["menu_options", "pricing", "margin_notes", "assumptions"]
    },
    "CustomerReplyDraft": {
      "required": ["reply_text", "notes_for_owner", "approval_required"]
    },
    "OwnerResearchBrief": {
      "required": ["conclusion", "verified_facts", "model_inference", "missing_data", "action_bucket", "invalidation"]
    },
    "PitfallEntry": {
      "required": ["trigger", "root_cause", "fix", "prevention"]
    },
    "VisibleEntrypoint": {
      "required": ["path", "open_command", "owner_visible_surface", "verification"]
    }
  }
}
