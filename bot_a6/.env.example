# MAPLAB A6 報價助理 bot — 環境變數範本
# 複製此檔案為 .env 並填入真實值（.env 已加入 .gitignore，不會被 commit）

# 從 @BotFather 取得（/newbot 或 /revoke 後重新申請）
A6_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

OWNER_USER_ID=1077768811

# 業務的 Telegram user ID（業務傳 /start 給 @userinfobot 查詢，填入後重啟）
SALES_USER_ID=0

REPO_PATH=/Users/pagemacmini/maplab-ai-handbook

# GAS Web App URL（報價系統 doPost endpoint）
GAS_QUOTE_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Claude Code OAuth Token — 從 claude.ai Settings > Account 取得
# ⚠️ 絕對不能 commit 到 git！
CLAUDE_CODE_OAUTH_TOKEN=YOUR_CLAUDE_OAUTH_TOKEN_HERE

# Ollama（地端模式用）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_CHAT=llama3.1:latest
OLLAMA_TIMEOUT_SECONDS=45

# Case Store（只讀 Google Sheet CONVERSATION_LOG，寫本機案件索引）
# 不填則使用 /Users/pagemacmini/maplab-ai-handbook/data/case-store/a6_case_store.sqlite3
CASE_STORE_DB_PATH=
CASE_STORE_SYNC_ROWS=600
GOOGLE_OAUTH_TOKEN_PATH=/Users/pagemacmini/.claude/mcp-keys/google-token.json
CASE_STORE_FALLBACK_JSON=/Users/pagemacmini/maplab-ai-handbook/data/case-store/conversation_log_seed.json
