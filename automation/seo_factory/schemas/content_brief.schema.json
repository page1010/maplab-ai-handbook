{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContentBrief",
  "type": "object",
  "required": [
    "pillar",
    "target_intent",
    "audience",
    "required_sections",
    "banned_topics"
  ],
  "properties": {
    "pillar": { "type": "string" },
    "target_intent": { "type": "string", "minLength": 10 },
    "audience": { "type": "string", "minLength": 5 },
    "required_sections": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string" }
    },
    "banned_topics": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
