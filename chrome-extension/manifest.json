{
  "manifest_version": 3,
  "name": "MAPLAB Agent Commander",
  "version": "5.4.0",
  "description": "角色召喚 + GitHub 任務模組 + Gemini/Codex/OpenClaw handoff。",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite", "sidePanel"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
