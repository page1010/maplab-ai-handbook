{
  "manifest_version": 3,
  "name": "MAPLAB Agent Commander",
  "version": "4.0.0",
  "description": "Loads CURRENT_STATUS + commit history. Token-auth for private repos.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
