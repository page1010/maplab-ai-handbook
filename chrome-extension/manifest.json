{
    "manifest_version": 3,
    "name": "MAPLAB Agent Commander",
    "version": "2.0.0",
    "description": "Auto-loads CURRENT_STATUS + A1-A7 skills into Claude tabs.",
    "permissions": ["storage", "activeTab", "scripting", "tabs"],
    "host_permissions": [
          "https://claude.ai/*",
          "https://raw.githubusercontent.com/*"
    ],
    "action": {
          "default_popup": "popup.html"
    },
    "content_scripts": [
          {
                  "matches": ["https://claude.ai/*"],
                  "js": ["content.js"],
                  "css": ["content.css"],
                  "run_at": "document_idle"
          }
    ],
    "background": {
          "service_worker": "background.js"
    }
}
