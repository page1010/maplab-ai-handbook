{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maplab.local/schemas/sol56-hermes-training-retrospective-v1.json",
  "title": "Sol 5.6 Hermes Training Retrospective Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "mode",
    "verdict",
    "activity_map",
    "learning_proof",
    "safety_counts",
    "evidence_ledger",
    "causal_breakpoint",
    "method_choice",
    "recurrence_controls",
    "success_contract",
    "shadow_adoption",
    "next_bounded_experiment",
    "receipts",
    "writebacks"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "read_only" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "writebacks": {
            "properties": { "status": { "enum": ["PROPOSED_WRITEBACKS_NOT_APPLIED", "NONE"] } },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "weight_learning": { "const": "PROVEN" } },
            "required": ["weight_learning"]
          }
        }
      },
      "then": {
        "properties": {
          "activity_map": {
            "properties": {
              "optimizer_steps": { "type": "integer", "minimum": 1 },
              "training_runs": { "type": "integer", "minimum": 1 },
              "qualification_cases": { "type": "integer", "minimum": 1 }
            },
            "required": ["optimizer_steps", "training_runs", "qualification_cases"]
          },
          "learning_proof": {
            "properties": {
              "optimizer_receipt": { "type": "string", "minLength": 1 },
              "weight_delta_receipt": { "type": "string", "minLength": 1 },
              "reload_receipt": { "type": "string", "minLength": 1 },
              "paired_qualification_receipt": { "type": "string", "minLength": 1 }
            },
            "required": ["optimizer_receipt", "weight_delta_receipt", "reload_receipt", "paired_qualification_receipt"]
          },
          "evidence_ledger": {
            "properties": {
              "verified": {
                "contains": {
                  "properties": { "code": { "const": "WEIGHT_UPDATE_PROOF" } },
                  "required": ["code"]
                }
              }
            }
          },
          "receipts": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "system_quality": { "const": "IMPROVED" } },
            "required": ["system_quality"]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "properties": { "safety": { "const": "PASS" } },
            "required": ["safety"]
          },
          "activity_map": {
            "properties": {
              "qualification_cases": { "type": "integer", "minimum": 1 },
              "shadow_cases": { "type": "integer", "minimum": 1 }
            },
            "required": ["qualification_cases", "shadow_cases"]
          },
          "learning_proof": {
            "properties": {
              "paired_qualification_receipt": { "type": "string", "minLength": 1 },
              "system_shadow_receipt": { "type": "string", "minLength": 1 }
            },
            "required": ["paired_qualification_receipt", "system_shadow_receipt"]
          },
          "shadow_adoption": {
            "properties": {
              "panel_size": { "type": "integer", "minimum": 1 },
              "eligible_denominator": { "type": "integer", "minimum": 1 },
              "direct_use": { "type": "integer", "minimum": 0 },
              "minor_edit": { "type": "integer", "minimum": 0 },
              "major_edit": { "type": "integer", "minimum": 0 },
              "reject": { "type": "integer", "minimum": 0 },
              "excluded_cases": { "type": "integer", "minimum": 0 },
              "time_window": { "type": "string", "minLength": 1 },
              "reviewers": { "type": "array", "minItems": 1 },
              "adjudicator": { "type": "string", "minLength": 1 }
            },
            "required": ["panel_size", "eligible_denominator", "direct_use", "minor_edit", "major_edit", "reject", "excluded_cases", "time_window", "reviewers", "adjudicator"]
          },
          "success_contract": {
            "properties": {
              "sample_plan": {
                "properties": { "status": { "const": "REGISTERED" } },
                "required": ["status"]
              }
            }
          },
          "evidence_ledger": {
            "properties": {
              "verified": {
                "contains": {
                  "properties": { "code": { "const": "SYSTEM_QUALITY_PROOF" } },
                  "required": ["code"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "safety": { "const": "PASS" } },
            "required": ["safety"]
          }
        }
      },
      "then": {
        "properties": {
          "safety_counts": {
            "properties": {
              "hard_violations_total": { "const": 0 },
              "unauthorized_commercial_claims": { "const": 0 },
              "privacy_leaks": { "const": 0 },
              "customer_sends": { "const": 0 },
              "other_hard_violations": { "const": 0 }
            },
            "required": ["hard_violations_total", "unauthorized_commercial_claims", "privacy_leaks", "customer_sends", "other_hard_violations"]
          },
          "learning_proof": {
            "properties": { "safety_receipt": { "type": "string", "minLength": 1 } },
            "required": ["safety_receipt"]
          },
          "evidence_ledger": {
            "properties": {
              "verified": {
                "contains": {
                  "properties": { "code": { "const": "SAFETY_ZERO_PROOF" } },
                  "required": ["code"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "safety": { "const": "FAIL" } },
            "required": ["safety"]
          }
        }
      },
      "then": {
        "properties": {
          "safety_counts": {
            "properties": { "hard_violations_total": { "type": "integer", "minimum": 1 } },
            "required": ["hard_violations_total"]
          },
          "evidence_ledger": {
            "properties": {
              "verified": {
                "contains": {
                  "properties": { "code": { "const": "HARD_SAFETY_VIOLATION" } },
                  "required": ["code"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "promotion": { "const": "ELIGIBLE" } },
            "required": ["promotion"]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "properties": {
              "system_quality": { "const": "IMPROVED" },
              "safety": { "const": "PASS" }
            },
            "required": ["system_quality", "safety"]
          },
          "success_contract": {
            "properties": {
              "sample_plan": {
                "properties": { "status": { "const": "REGISTERED" } },
                "required": ["status"]
              }
            }
          },
          "receipts": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "organizational_learning": { "const": "INSTITUTIONALIZED" } },
            "required": ["organizational_learning"]
          }
        }
      },
      "then": {
        "properties": {
          "mode": { "const": "write_authorized" },
          "writebacks": {
            "properties": { "status": { "const": "APPLIED" } },
            "required": ["status"]
          },
          "evidence_ledger": {
            "properties": {
              "verified": {
                "contains": {
                  "properties": { "code": { "const": "WRITEBACK_PROOF" } },
                  "required": ["code"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity_map": {
            "properties": { "mapping_status": { "const": "COMPLETE" } },
            "required": ["mapping_status"]
          }
        }
      },
      "then": {
        "properties": {
          "activity_map": {
            "properties": {
              "mapping_receipt": { "type": "string", "minLength": 1 },
              "mapping_missing_reason": { "type": "null" },
              "unmapped_attempts": { "const": 0 },
              "activity_links": { "minItems": 1 }
            },
            "required": ["mapping_receipt", "mapping_missing_reason", "unmapped_attempts", "activity_links"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity_map": {
            "properties": { "mapping_status": { "const": "MISSING" } },
            "required": ["mapping_status"]
          }
        }
      },
      "then": {
        "properties": {
          "activity_map": {
            "properties": {
              "mapping_receipt": { "type": "null" },
              "mapping_missing_reason": { "type": "string", "minLength": 1 }
            },
            "required": ["mapping_receipt", "mapping_missing_reason"]
          },
          "evidence_ledger": {
            "properties": {
              "missing": {
                "contains": {
                  "properties": { "code": { "const": "ACTIVITY_MAPPING_MISSING" } },
                  "required": ["code"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity_map": {
            "properties": { "mapping_status": { "const": "PARTIAL" } },
            "required": ["mapping_status"]
          }
        }
      },
      "then": {
        "properties": {
          "activity_map": {
            "properties": {
              "mapping_receipt": { "type": "string", "minLength": 1 },
              "mapping_missing_reason": { "type": "string", "minLength": 1 },
              "unmapped_attempts": { "type": "integer", "minimum": 1 }
            },
            "required": ["mapping_receipt", "mapping_missing_reason", "unmapped_attempts"]
          },
          "evidence_ledger": {
            "properties": {
              "missing": {
                "contains": {
                  "properties": { "code": { "const": "ACTIVITY_MAPPING_PARTIAL" } },
                  "required": ["code"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "success_contract": {
            "properties": {
              "sample_plan": {
                "properties": { "status": { "const": "REGISTERED" } },
                "required": ["status"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "success_contract": {
            "properties": {
              "sample_plan": {
                "properties": {
                  "panel_size": { "type": "integer", "minimum": 1 },
                  "smallest_meaningful_improvement": { "type": "string", "minLength": 1 },
                  "paired_decision_method": { "type": "string", "minLength": 1 },
                  "time_window": { "type": "string", "minLength": 1 },
                  "decision_threshold": { "type": "string", "minLength": 1 }
                },
                "required": ["panel_size", "smallest_meaningful_improvement", "paired_decision_method", "time_window", "decision_threshold"]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "maplab.sol56-hermes-training-retrospective.v1" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["read_only", "write_authorized"] },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight_learning", "system_quality", "organizational_learning", "safety", "promotion"],
      "properties": {
        "weight_learning": { "enum": ["PROVEN", "NOT_PROVEN", "FAILED"] },
        "system_quality": { "enum": ["IMPROVED", "NOT_PROVEN", "REGRESSED"] },
        "organizational_learning": { "enum": ["INSTITUTIONALIZED", "PROPOSED", "MISSING"] },
        "safety": { "enum": ["PASS", "FAIL", "MISSING"] },
        "promotion": { "enum": ["ELIGIBLE", "BLOCKED"] }
      }
    },
    "activity_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_attempts", "responses", "examples", "evaluation_rounds", "optimizer_steps", "training_runs", "qualification_cases", "shadow_cases", "retry_attempts", "fallback_attempts", "unmapped_attempts", "mapping_status", "mapping_receipt", "mapping_missing_reason", "activity_links"],
      "properties": {
        "provider_attempts": { "type": ["integer", "null"], "minimum": 0 },
        "responses": { "type": ["integer", "null"], "minimum": 0 },
        "examples": { "type": ["integer", "null"], "minimum": 0 },
        "evaluation_rounds": { "type": ["integer", "null"], "minimum": 0 },
        "optimizer_steps": { "type": ["integer", "null"], "minimum": 0 },
        "training_runs": { "type": ["integer", "null"], "minimum": 0 },
        "qualification_cases": { "type": ["integer", "null"], "minimum": 0 },
        "shadow_cases": { "type": ["integer", "null"], "minimum": 0 },
        "retry_attempts": { "type": ["integer", "null"], "minimum": 0 },
        "fallback_attempts": { "type": ["integer", "null"], "minimum": 0 },
        "unmapped_attempts": { "type": ["integer", "null"], "minimum": 0 },
        "mapping_status": { "enum": ["COMPLETE", "PARTIAL", "MISSING"] },
        "mapping_receipt": { "type": ["string", "null"] },
        "mapping_missing_reason": { "type": ["string", "null"] },
        "activity_links": {
          "type": "array",
          "items": { "$ref": "#/$defs/activity_link" }
        }
      }
    },
    "learning_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optimizer_receipt", "weight_delta_receipt", "reload_receipt", "paired_qualification_receipt", "system_shadow_receipt", "safety_receipt"],
      "properties": {
        "optimizer_receipt": { "type": ["string", "null"] },
        "weight_delta_receipt": { "type": ["string", "null"] },
        "reload_receipt": { "type": ["string", "null"] },
        "paired_qualification_receipt": { "type": ["string", "null"] },
        "system_shadow_receipt": { "type": ["string", "null"] },
        "safety_receipt": { "type": ["string", "null"] }
      }
    },
    "safety_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_violations_total", "unauthorized_commercial_claims", "privacy_leaks", "customer_sends", "other_hard_violations"],
      "properties": {
        "hard_violations_total": { "type": ["integer", "null"], "minimum": 0 },
        "unauthorized_commercial_claims": { "type": ["integer", "null"], "minimum": 0 },
        "privacy_leaks": { "type": ["integer", "null"], "minimum": 0 },
        "customer_sends": { "type": ["integer", "null"], "minimum": 0 },
        "other_hard_violations": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "evidence_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "inference", "missing"],
      "properties": {
        "verified": { "$ref": "#/$defs/claims" },
        "inference": { "$ref": "#/$defs/claims" },
        "missing": { "$ref": "#/$defs/claims" }
      }
    },
    "causal_breakpoint": { "type": "string", "minLength": 1 },
    "method_choice": { "type": "string", "minLength": 1 },
    "recurrence_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detect", "contain", "correct", "institutionalize"],
      "properties": {
        "detect": { "type": "string", "minLength": 1 },
        "contain": { "type": "string", "minLength": 1 },
        "correct": { "type": "string", "minLength": 1 },
        "institutionalize": { "type": "string", "minLength": 1 }
      }
    },
    "success_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "process", "sample_plan"],
      "properties": {
        "outcome": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "process": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "sample_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "panel_size", "smallest_meaningful_improvement", "paired_decision_method", "time_window", "decision_threshold"],
          "properties": {
            "status": { "enum": ["REGISTERED", "MISSING"] },
            "panel_size": { "type": ["integer", "null"], "minimum": 1 },
            "smallest_meaningful_improvement": { "type": ["string", "null"] },
            "paired_decision_method": { "type": ["string", "null"] },
            "time_window": { "type": ["string", "null"] },
            "decision_threshold": { "type": ["string", "null"] }
          }
        }
      }
    },
    "shadow_adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel_size", "eligible_denominator", "direct_use", "minor_edit", "major_edit", "reject", "excluded_cases", "time_window", "reviewers", "adjudicator"],
      "properties": {
        "panel_size": { "type": ["integer", "null"], "minimum": 0 },
        "eligible_denominator": { "type": ["integer", "null"], "minimum": 0 },
        "direct_use": { "type": ["integer", "null"], "minimum": 0 },
        "minor_edit": { "type": ["integer", "null"], "minimum": 0 },
        "major_edit": { "type": ["integer", "null"], "minimum": 0 },
        "reject": { "type": ["integer", "null"], "minimum": 0 },
        "excluded_cases": { "type": ["integer", "null"], "minimum": 0 },
        "time_window": { "type": ["string", "null"] },
        "reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "adjudicator": { "type": ["string", "null"] }
      }
    },
    "next_bounded_experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "single_primary_variable", "fixed_inputs", "pass_condition", "falsifier", "stop_conditions", "artifacts"],
      "properties": {
        "hypothesis": { "type": "string", "minLength": 1 },
        "single_primary_variable": { "type": "string", "minLength": 1 },
        "fixed_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "pass_condition": { "type": "string", "minLength": 1 },
        "falsifier": { "type": "string", "minLength": 1 },
        "stop_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "receipts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "writebacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "targets"],
      "properties": {
        "status": { "enum": ["APPLIED", "PROPOSED_WRITEBACKS_NOT_APPLIED", "NONE"] },
        "targets": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "activity_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_attempt_id", "response_id", "outcome", "example_id", "evaluation_round_id", "retry_of_attempt_id", "fallback_from_attempt_id"],
      "properties": {
        "provider_attempt_id": { "type": "string", "minLength": 1 },
        "response_id": { "type": ["string", "null"] },
        "outcome": { "enum": ["response", "http_error", "transport_error", "blocked_before_transport", "crash_after_reservation"] },
        "example_id": { "type": ["string", "null"] },
        "evaluation_round_id": { "type": ["string", "null"] },
        "retry_of_attempt_id": { "type": ["string", "null"] },
        "fallback_from_attempt_id": { "type": ["string", "null"] }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "claim", "evidence"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": { "type": ["string", "null"] }
        }
      }
    }
  }
}
