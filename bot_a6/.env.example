# MAPLAB A6 報價助理 bot — 環境變數
# cp .env.example .env 然後填入真實值

# 1. 向 @BotFather 申請新 bot，取得 token
A6_BOT_TOKEN=your_a6_bot_token_here

# 2. Owner 的 Telegram user ID（和 A1 bot 相同）
OWNER_USER_ID=1077768811

# 3. 業務的 Telegram user ID
#    業務傳 /id 給 @userinfobot 可查到
SALES_USER_ID=0

# 4. Repo 路徑（通常不用改）
REPO_PATH=/Users/pagemacmini/maplab-ai-handbook

# 5. Claude Code OAuth token（和 A1 bot 相同，從 bot/.env 複製）
CLAUDE_CODE_OAUTH_TOKEN=your_oauth_token_here
