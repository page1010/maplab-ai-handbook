<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maplab.culture-loop</string>

  <!-- 地端模型驅動，非 Claude；每日 08:30 觸發 -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/pagemacmini/maplab-ai-handbook/scripts/culture_loop_runner.py</string>
    <string>--mode</string>
    <string>full</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/pagemacmini/maplab-ai-handbook</string>

  <!-- 每天 08:30 跑一次（趕在 Owner 工作前完成） -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/Users/pagemacmini/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>OLLAMA_BASE_URL</key>
    <string>http://127.0.0.1:11434</string>
    <key>CULTURE_LOOP_MODEL</key>
    <string>qwen2.5:14b</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/pagemacmini/maplab-ai-handbook/logs/culture-loop.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pagemacmini/maplab-ai-handbook/logs/culture-loop-err.log</string>

  <!-- 超過 5 分鐘就 kill（Ollama 應該 < 2 分鐘） -->
  <key>TimeOut</key>
  <integer>300</integer>
</dict>
</plist>
