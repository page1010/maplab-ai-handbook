{
  "manifest_version": 3,
  "name": "MAPLAB Agent Commander",
  "version": "5.7.0",
  "description": "角色召喚 + 指向性治理地圖 + GitHub 任務模組 + Markdown freshness + multi-runtime handoff。",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite", "sidePanel", "alarms"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
