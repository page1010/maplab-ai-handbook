{
  "manifest_version": 3,
  "name": "MAPLAB Agent Commander",
  "version": "5.0.0",
  "description": "角色召喚 + 系統快照注入 + 直接填入 Claude tab。",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite", "sidePanel"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
