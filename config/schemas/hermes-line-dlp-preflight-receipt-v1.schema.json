{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maplab.local/schemas/hermes-line-dlp-preflight-receipt-v1.schema.json",
  "title": "Hermes LINE offline DLP preflight receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "status",
    "eligible_for_offline_training",
    "reason_codes",
    "manifest",
    "scan",
    "privacy",
    "execution",
    "provenance",
    "body_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "maplab.hermes.line-dlp-preflight-receipt.v1"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "eligible_for_offline_training": {"type": "boolean"},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sha256",
        "dataset_id",
        "authority_status",
        "retention_status",
        "free_text_review_status",
        "rights_controls_complete"
      ],
      "properties": {
        "schema_version": {"const": "maplab.hermes.line-dlp-rights-manifest.v1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "authority_status": {
          "enum": ["PENDING", "APPROVED", "REVOKED", "EXPIRED"]
        },
        "retention_status": {"enum": ["PENDING", "ACTIVE", "EXPIRED"]},
        "free_text_review_status": {
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "rights_controls_complete": {"type": "boolean"}
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_file_count",
        "record_count",
        "byte_count",
        "invalid_json_records",
        "non_object_records",
        "scan_errors",
        "high_confidence_findings",
        "review_required_findings",
        "findings_by_category",
        "files"
      ],
      "properties": {
        "dataset_file_count": {"type": "integer", "minimum": 1},
        "record_count": {"type": "integer", "minimum": 0},
        "byte_count": {"type": "integer", "minimum": 0},
        "invalid_json_records": {"type": "integer", "minimum": 0},
        "non_object_records": {"type": "integer", "minimum": 0},
        "scan_errors": {"type": "integer", "minimum": 0},
        "high_confidence_findings": {"type": "integer", "minimum": 0},
        "review_required_findings": {"type": "integer", "minimum": 0},
        "findings_by_category": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,127}$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logical_name",
              "sha256",
              "record_count",
              "byte_count",
              "invalid_json_records",
              "non_object_records",
              "scan_errors",
              "high_confidence_findings",
              "review_required_findings"
            ],
            "properties": {
              "logical_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "record_count": {"type": "integer", "minimum": 0},
              "byte_count": {"type": "integer", "minimum": 0},
              "invalid_json_records": {"type": "integer", "minimum": 0},
              "non_object_records": {"type": "integer", "minimum": 0},
              "scan_errors": {"type": "integer", "minimum": 0},
              "high_confidence_findings": {"type": "integer", "minimum": 0},
              "review_required_findings": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text_emitted",
        "matched_values_emitted",
        "source_paths_emitted",
        "aggregate_counts_only"
      ],
      "properties": {
        "raw_text_emitted": {"const": false},
        "matched_values_emitted": {"const": false},
        "source_paths_emitted": {"const": false},
        "aggregate_counts_only": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_calls",
        "model_calls",
        "local_model_calls",
        "training_runs_started",
        "customer_sends"
      ],
      "properties": {
        "network_calls": {"const": 0},
        "model_calls": {"const": 0},
        "local_model_calls": {"const": 0},
        "training_runs_started": {"const": 0},
        "customer_sends": {"const": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner_sha256", "manifest_sha256", "schema_sha256"],
      "properties": {
        "scanner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "eligible_for_offline_training": {"const": true},
          "reason_codes": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}},
      "then": {
        "properties": {
          "eligible_for_offline_training": {"const": false},
          "reason_codes": {"minItems": 1}
        }
      }
    }
  ]
}
