<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.investmentos.b-role-maintenance</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/pagemacmini/maplab-ai-handbook/scripts/b_role_local_maintenance.sh</string>
  </array>

  <!-- 每週一 09:00 台北時間（UTC+8 = 01:00 UTC，launchd 用本地時間）-->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/pagemacmini/maplab-ai-handbook/logs/b_role_maintenance.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pagemacmini/maplab-ai-handbook/logs/b_role_maintenance_err.log</string>

  <!-- 最長 10 分鐘，超過就 kill（Ollama 回應可能慢）-->
  <key>TimeOut</key>
  <integer>600</integer>

  <!-- launchd 在 session 結束後仍可跑 -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
